{
  "testEnvironment": "node",
  "rootDir": "../..",
  "roots": ["<rootDir>/test/integration"],
  "testRegex": ".*\\.int-spec\\.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "testTimeout": 60000,
  "verbose": true
}
