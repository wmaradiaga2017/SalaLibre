// Modelo de datos de SalaLibre (spec §7).
// Las restricciones que Prisma no expresa (CHECK, índice único sobre lower(name), EXCLUDE anti-choque y
// trigger de inmutabilidad de audit_logs) viven en migraciones SQL propias. Nunca se regeneran ni se eliminan.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum Equipment {
  PROJECTOR
  VIDEOCONF
  WHITEBOARD
  TV
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum AuditAction {
  BOOKING_CREATED
  BOOKING_CANCELLED
  ROOM_CREATED
  ROOM_UPDATED
  USER_CREATED
  USER_UPDATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  CLOSURE_CREATED
  CLOSURE_DELETED
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings          Booking[]  @relation("BookingOwner")
  cancelledBookings Booking[]  @relation("BookingCancelledBy")
  closures          Closure[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Room {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @db.VarChar(60)
  capacity  Int
  location  String      @db.VarChar(100)
  equipment Equipment[] @default([])
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]

  @@map("rooms")
}

model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String        @map("room_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  title         String        @db.VarChar(100)
  attendees     Int
  startAt       DateTime      @map("start_at") @db.Timestamptz(3)
  endAt         DateTime      @map("end_at") @db.Timestamptz(3)
  status        BookingStatus @default(CONFIRMED)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?       @map("cancelled_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  room        Room  @relation(fields: [roomId], references: [id])
  user        User  @relation("BookingOwner", fields: [userId], references: [id])
  cancelledBy User? @relation("BookingCancelledBy", fields: [cancelledById], references: [id])

  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@map("bookings")
}

model Closure {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime @unique @db.Date
  reason      String   @db.VarChar(100)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("closures")
}

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id") @db.Uuid
  data      Json        @default("{}")
  requestId String      @map("request_id")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
